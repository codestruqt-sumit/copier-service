# Identity of this copier instance (must match a Copier created in the Sender's Config tab)
COPIER_NAME=VM-1
# The Sender (signal provider) base URL
SENDER_BASE_URL=https://YOUR-SENDER.azurewebsites.net
# The one-time API key issued by the Sender's Config tab
COPIER_KEY=paste-key-here
# Local dashboard bind
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8100
# Durable state directory (SQLite lives here; mount as a volume in Docker)
DATA_DIR=./data

# --- Execution mode -----------------------------------------------------------
# web (default) = Selenium browser automation.  api = Tradovate REST + WebSocket.
COPIER_MODE=web

# --- API mode: Tradovate OAuth (only read when COPIER_MODE=api) ----------------
# Demo host for testing; live = https://live.tradovateapi.com/v1
TRADOVATE_BASE=https://demo.tradovateapi.com/v1
TRADOVATE_AUTH=oauth
# client_id is public (appears in the OAuth URL). client_secret is a SECRET:
# put the real value ONLY in the local .env, never in this example and never in git.
TRADOVATE_CLIENT_ID=your-oauth-client-id
TRADOVATE_CLIENT_SECRET=paste-secret-here
# Leave empty to derive http://localhost:<DASHBOARD_PORT>/oauth/tradovate/callback
TRADOVATE_REDIRECT_URI=

# --- API mode: DIRECT credentials (set TRADOVATE_AUTH=credentials to skip OAuth) --------
# Headless, per-VM: the user's OWN Tradovate login + API key (generate cid/sec in Tradovate
# > Application Settings > API Access). password + sec are SECRETS - real values only in
# the local .env, never in git. No redirect, no OAuth, no partner approval needed.
# TRADOVATE_AUTH=credentials
# TRADOVATE_NAME=your-tradovate-username
# TRADOVATE_PASSWORD=paste-password-here
# TRADOVATE_CID=your-api-key-id
# TRADOVATE_SEC=paste-api-secret-here
# TRADOVATE_APP_ID=CopierM46
# TRADOVATE_APP_VERSION=1.0
