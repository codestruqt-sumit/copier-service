# Identity of this copier instance (must match a Copier created in the Sender's Config tab)
COPIER_NAME=VM-1
# The Sender (signal provider) base URL
SENDER_BASE_URL=https://YOUR-SENDER.azurewebsites.net
# The one-time API key issued by the Sender's Config tab
COPIER_KEY=paste-key-here
# Local dashboard bind
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8100
# Durable state directory (SQLite lives here; mount as a volume in Docker)
DATA_DIR=./data
